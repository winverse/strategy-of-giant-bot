{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "SangHyun <public.winverse@gmail.com>",
  "private": true,
  "license": "MIT License",
  "type": "module",
  "imports": {
    "#common/*": "./src/common/*.ts",
    "#config/*": "./src/config/*.ts",
    "#database/*": "./src/database/*.ts",
    "#logger/*": "./src/logger/*.ts",
    "#price/*": "./src/price/*.ts",
    "#strategy/*": "./src/strategy/*.ts",
    "#telegram/*": "./src/telegram/*.ts",
    "#env/*": "./config/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "write:env": "bun ./scripts/write-env.ts",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:push": "bun run write:env && bun --env-file=.env x --bun prisma db push",
    "build": "bun ./scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "bun run start:dev",
    "start": "bun src/main.ts",
    "start:dev": "bun run write:env && bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:e2e": "bun test ./test",
    "test:unit": "bun test ./src",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.8",
    "joi": "^18.3.2",
    "node-telegram-bot-api": "^2.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fast-check": "4.10.2",
    "prisma": "~7.10.1",
    "typescript": "^7.0.2"
  }
}
