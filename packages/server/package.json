{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "SangHyun <public.winverse@gmail.com>",
  "private": true,
  "license": "MIT License",
  "imports": {
    "#common/*": "./src/common/*.ts",
    "#config/*": "./src/config/*.ts",
    "#database/*": "./src/database/*.ts",
    "#logger/*": "./src/logger/*.ts",
    "#price/*": "./src/price/*.ts",
    "#strategy/*": "./src/strategy/*.ts",
    "#telegram/*": "./src/telegram/*.ts",
    "#env/*": "./config/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "write:env": "bun ./scripts/write-env.ts",
    "prisma:generate": "bun run write:env && bunx prisma generate",
    "prisma:push": "bun run write:env && bunx prisma db push",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "bun src/main.ts",
    "start:dev": "bun run write:env && bun --watch src/main.ts",
    "start:prod": "bun src/main.ts",
    "test": "bun test",
    "test:e2e": "bun test ./test",
    "test:unit": "bun test ./src",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^9.1.2",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.1.2",
    "@nestjs/platform-fastify": "^9.1.2",
    "@nestjs/schedule": "^2.1.0",
    "@prisma/client": "^4.3.1",
    "axios": "^0.26.1",
    "date-fns": "^2.28.0",
    "fastify": "^4.7.0",
    "joi": "^17.6.0",
    "node-telegram-bot-api": "^0.59.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "winston": "^3.8.2",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^9.1.2",
    "@types/bun": "^1.2.17",
    "@types/cron": "2.0.0",
    "@types/node": "^18.7.23",
    "fast-check": "4.10.2",
    "prisma": "^4.3.1",
    "typescript": "^7.0.2"
  }
}
