{
  "name": "giants-strategy-bot",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "author": "SangHyun <public.winverse@gmail.com>",
  "license": "MIT License",
  "keywords": [
    "quant",
    "investments",
    "VAA",
    "DAA"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "server:dev": "turbo run dev --filter=server",
    "web:dev": "turbo run dev --filter=web",
    "prisma:generate": "bun run --filter server prisma:generate",
    "prisma:push": "bun run --filter server prisma:push",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "^2.11.10"
  }
}
